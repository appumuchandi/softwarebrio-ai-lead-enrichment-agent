# Copy to .env and fill
# LLM provider: openai | anthropic | mock (mock = offline deterministic, no API key needed)
LLM_PROVIDER=mock

# OpenAI (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1  # optional override for proxy

# Anthropic (required if LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Scraping (vertical slice defaults, override if needed)
# WAIT_UNTIL=domcontentloaded
# NAV_TIMEOUT_MS=15000
# HEADLESS=true
# MAX_CONCURRENT_DOMAINS=3
# MAX_CONCURRENT_PAGES=4

# LLM tuning
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=1800
